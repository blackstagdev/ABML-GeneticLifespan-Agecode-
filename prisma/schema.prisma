// AgeCode Bridge database (PostgreSQL on Render).
// See https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shopify sessions (from the app template)
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One job per paid Shopify order. Created by the orders/paid webhook, processed by the worker.
//
// status:
//   pending      - waiting to be processed
//   processing   - claimed by the worker (lockedAt set)
//   retry        - nothing reached Genetic LifeSpan yet (Shopify API error, DNS, 429); runs again at nextAttemptAt
//   done         - sent to Genetic LifeSpan (and fulfilled when AUTO_FULFILL is on)
//   dry_run      - payload built but not sent (GLS_MODE=dry_run)
//   needs_check  - GLS answered 5xx / timed out: the order may exist there. Never resent automatically;
//                  ask Genetic LifeSpan, then "Mark as sent" or "Resend" in the app
//   no_agecode   - the order has no AgeCode line items
//   cancelled    - the order was cancelled before it was sent
//   failed       - needs a person: missing data, GLS 4xx, or retries used up
model OrderJob {
  id            String    @id @default(cuid())
  shop          String
  orderGid      String    @unique
  orderName     String?
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sync          GlsSync?

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

// The request sent (or to be sent) to Genetic LifeSpan for one Shopify order.
// V2 spec: one GLS order per Shopify order; several AgeCode products go in items[].
//
// status: pending | sending | sent | dry_run | failed | needs_check
//   "sending" is saved before the POST, so a crash mid-request can't lead to a duplicate:
//   a row found in "sending" is treated as needs_check, never resent automatically.
model GlsSync {
  id             String    @id @default(cuid())
  jobId          String    @unique
  job            OrderJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  orderGid       String    @unique
  orderName      String
  alphaOrderId   String
  isTest         Boolean   @default(false)
  // [{ lineItemId, productType, quantity, unitPrice, lineTotal }]
  items          Json
  // e.g. "AgeCode Premier ×1, AgeCode Wellness Essentials ×2"
  summary        String
  pricePaid      Decimal   @db.Decimal(12, 2)
  status         String    @default("pending")
  attempts       Int       @default(0)
  lastError      String?
  lastStatusCode Int?
  requestPayload Json
  responseBody   Json?
  glsOrderId     String?
  glsOrderName   String?
  sentAt         DateTime?
  fulfilledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([sentAt])
}
