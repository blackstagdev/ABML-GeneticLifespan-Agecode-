# Copy to .env for local development. In production these are set in Render (see render.yaml).

# Postgres connection (local: e.g. docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agecode_bridge

# Filled in automatically by `shopify app dev`; set by hand on Render
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_orders,write_orders,read_products,read_customers,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders

# Genetic LifeSpan channel API
#   dry_run (default) - build and log payloads, send nothing
#   mock              - send to the fake API built into this app (/mock/gls/...)
#   live              - send to GLS_API_BASE (needs GLS_API_KEY)
GLS_MODE=dry_run
GLS_API_KEY=
GLS_API_BASE=https://gls-channel-api.geneticlifespan.com
GLS_CHANNEL_ID=alpha-biomed
# line_total (default): discounted line total; unit: line total / quantity
GLS_PRICE_MODE=line_total
# Append shipping address line 2 to address1 (the API has no address2 field)
GLS_APPEND_ADDRESS2=true
GLS_MAX_ATTEMPTS=6
GLS_TIMEOUT_MS=15000

# Mark AgeCode items fulfilled (no customer email) once GLS accepts them, so ShipStation skips them
AUTO_FULFILL=true

# Optional alerts when an order can't be sent
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
RESEND_API_KEY=
ALERT_EMAIL_FROM=AgeCode Bridge <alerts@alphabiomedlabs.com>

# Set to true to stop the background worker (e.g. when running one-off scripts)
DISABLE_WORKER=false
